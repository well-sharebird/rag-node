# ============================================================
# RAG Backend Configuration
# ============================================================
# Copy this file to .env and adjust for your environment.

# Application
APP_NAME="RAG Backend"
DEBUG=false
DEV_MODE=false

# ============================================================
# PostgreSQL — business metadata
# ============================================================
PG_HOST=10.0.0.1            # Your PostgreSQL server IP
PG_PORT=5432
PG_USER=rag
PG_PASSWORD=rag_password
PG_DB=rag
PG_POOL_SIZE=20             # asyncpg connection pool size
PG_MAX_OVERFLOW=10          # Max overflow connections
PG_POOL_RECYCLE=3600        # Recycle connections after 1 hour
PG_POOL_TIMEOUT=30          # Connection timeout (seconds)

# ============================================================
# Milvus — vector database
# ============================================================
MILVUS_HOST=10.0.0.1        # Your Milvus server IP
MILVUS_PORT=19530
MILVUS_USER=                # Leave empty if auth disabled
MILVUS_PASSWORD=
MILVUS_DB_NAME=default

# ============================================================
# Redis — cache + queue
# ============================================================
REDIS_HOST=10.0.0.1         # Your Redis server IP
REDIS_PORT=6379
REDIS_PASSWORD=redis_password
REDIS_DB=0
REDIS_POOL_SIZE=20          # Connection pool max connections
REDIS_POOL_TIMEOUT=30       # Pool wait timeout
REDIS_SOCKET_TIMEOUT=10     # Read/write timeout
REDIS_SOCKET_CONNECT_TIMEOUT=5
REDIS_RETRY_ON_TIMEOUT=true
REDIS_HEALTH_CHECK_INTERVAL=30  # Seconds between health checks

# ============================================================
# MinIO — document object storage
# ============================================================
MINIO_HOST=10.0.0.1         # Your MinIO server IP
MINIO_PORT=9000             # API port (console is 9001)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=rag-documents
MINIO_SECURE=false

# ============================================================
# Embedding Model
# ============================================================
EMBEDDING_PROVIDER=local    # "local" (sentence-transformers) or "api"
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# EMBEDDING_API_URL=https://api.openai.com  # if provider=api
# EMBEDDING_API_KEY=sk-xxx

# ============================================================
# CORS
# ============================================================
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
