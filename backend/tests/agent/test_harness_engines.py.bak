@pytest.mark.asyncio
async def test_orchestration_voting_mode(mock_db):
    """测试投票模式"""
    config = OrchestrationConfig(
        mode=OrchestrationMode.VOTING,
        workers=[
            WorkerAgent(agent_id="voter-1", role="voter"),
            WorkerAgent(agent_id="voter-2", role="voter"),
            WorkerAgent(agent_id="voter-3", role="voter"),
        ],
        voting_threshold=0.67,
    )

    engine = OrchestrationEngine(mock_db, config)

    result = await engine.execute_multi_agent(
        runtime_id="runtime-test",
        session_id="session-test",
        user_input="评估方案",
    )

    assert result["mode"] == "voting"
    assert "results" in result
    assert "vote_count" in result


@pytest.mark.asyncio
async def test_task_validation(mock_db):
