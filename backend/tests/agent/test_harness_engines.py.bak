@pytest.mark.asyncio
async def test_orchestration_supervisor_mode(mock_db):
    """测试主管分配模式"""
    config = OrchestrationConfig(
        mode=OrchestrationMode.SUPERVISOR,
        workers=[
            WorkerAgent(agent_id="worker-1", role="researcher"),
            WorkerAgent(agent_id="worker-2", role="writer"),
        ],
    )

    engine = OrchestrationEngine(mock_db, config)

    result = await engine.execute_multi_agent(
        runtime_id="runtime-test",
        session_id="session-test",
        user_input="测试任务",
    )

    assert result["mode"] == "supervisor"
    assert "tasks" in result


